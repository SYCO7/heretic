[15.841093, "o", "\u001b[3m                                   HERETIC — 5 confirmed findings                                   \u001b[0m\r\n┏━━━━━━━━━━┳━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mseverity\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mconf\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mclass                  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1minvariant               \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mtitle                    \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━╇━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ bola                    │ BOLA:basket              │ BOLA — userB reads        │\r\n│          │      │                         │                          │ userA's basket #6         │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ bola                    │ BOLA:basket              │ BOLA — userA reads        │\r\n│          │      │                         │                          │ userB's basket #7         │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ excessive_data_exposure │ EDE:basketitem           │ excessive_data_exposure — │\r\n│          │      │                         │                          │ basketitem list leaks all │\r\n│          │      │                         │                          │ users' records            │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ bfla                    │ BFLA:/rest/admin/applic… │ bfla — admin function     │\r\n│          │      │                         │                          │ /rest/admin/application-… │\r\n│          │      │                         │                          │ is exposed to             │\r\n│          │      │                         │                          │ unauthenticated users     │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ chain                   │ CHAIN:bulk_data_exfiltr… │ Bulk data exfiltration    │\r\n└──────────┴──────┴─────────────────────────┴──────────────────────────┴───────────────────────────┘\r\n"]

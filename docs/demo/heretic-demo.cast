[23.528064, "o", "  \u001b[31mCONFIRM\u001b[0m bfla — admin function \u001b[35m/users/v1/\u001b[0m\u001b[95m_debug\u001b[0m is exposed to unauthenticated users\r\n\u001b[92m────────────────────────────── \u001b[0m\u001b[1mPhase \u001b[0m\u001b[1;36m6\u001b[0m chaining — compose primitives\u001b[92m ───────────────────────────────\u001b[0m\r\n  \u001b[35mCHAIN\u001b[0m Bulk data exfiltration \u001b[1m(\u001b[0mhigh\u001b[1m)\u001b[0m\r\n\u001b[92m──────────────────────────── \u001b[0m\u001b[1;32m6\u001b[0m\u001b[1;32m confirmed\u001b[0m · \u001b[1;36m10\u001b[0m dropped \u001b[1m(\u001b[0mfalse positives\u001b[1m)\u001b[0m\u001b[92m ────────────────────────────\u001b[0m\r\n"]
[23.532249, "o", "\u001b[3m                                   HERETIC — 6 confirmed findings                                   \u001b[0m\r\n┏━━━━━━━━━━┳━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mseverity\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mconf\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mclass                  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1minvariant               \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mtitle                    \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━╇━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ bola                    │ BOLA:book                │ BOLA — userB reads        │\r\n│          │      │                         │                          │ userA's book #bookTitle57 │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ bola                    │ BOLA:book                │ BOLA — userA reads        │\r\n│          │      │                         │                          │ userB's book #bookTitle2  │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ excessive_data_exposure │ EDE:user                 │ excessive_data_exposure — │\r\n│          │      │                         │                          │ user exposes email to     │\r\n│          │      │                         │                          │ unauthenticated users     │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ excessive_data_exposure │ EDE:user2                │ excessive_data_exposure — │\r\n│          │      │                         │                          │ user2 exposes email,      │\r\n│          │      │                         │                          │ password to               │\r\n│          │      │                         │                          │ unauthenticated users     │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ bfla                    │ BFLA:/users/v1/_debug    │ bfla — admin function     │\r\n│          │      │                         │                          │ /users/v1/_debug is       │\r\n│          │      │                         │                          │ exposed to                │\r\n│          │      │                         │                          │ unauthenticated users     │\r\n│ \u001b[38;5;214mHIGH\u001b[0m     │ 100% │ chain                   │ CHAIN:bulk_data_exfiltr… │ Bulk data exfiltration    │\r\n└──────────┴──────┴─────────────────────────┴──────────────────────────┴───────────────────────────┘\r\n"]
[25.220753, "o", "\r\n════════════════════════════════════════════════════════════════\r\n  Every finding Oracle-proven. Nothing unproven was reported.\r\n  The LLM proposes; deterministic code confirms. That's the moat.\r\n  github.com/SYCO7/heretic\r\n════════════════════════════════════════════════════════════════\r\n"]
